#define CMD_WRITE    0xA3
#define CMD_READ     0xA4
#define CMD_PLAY     0xA5
#define CMD_STOP     0xA6
#define CMD_SET_FREQ 0xB0
#define CMD_GET_SYNC 0xB1
#define CMD_DAC_TEST 0xB2
#define ACK          0x06
#define NACK         0x15

#define DEFAULT_SAMPLE_CNT 256U

