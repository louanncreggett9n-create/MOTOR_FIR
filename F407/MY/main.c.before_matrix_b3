static uint16_t Rd16LE(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
static uint32_t Rd32LE(const uint8_t *p) { return ((uint32_t)p[0]) | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
static void Wr16LE(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
static void Wr32LE(uint8_t *p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }

static uint32_t CRC32_Calc(const uint8_t *data, uint32_t length)
{
    uint32_t crc = 0xFFFFFFFFUL;
    uint32_t i;
    uint8_t bit;
    for (i = 0; i < length; i++) {
        crc ^= data[i];
        for (bit = 0; bit < 8; bit++) {
            if (crc & 1UL) crc = (crc >> 1) ^ 0xEDB88320UL;
            else crc >>= 1;
        }
    }
    return crc ^ 0xFFFFFFFFUL;
}

static void UART_Write(uint8_t b)
{
    while ((USART1->SR & USART_FLAG_TXE) == 0);
    USART1->DR = b;
    while ((USART1->SR & USART_FLAG_TC) == 0);
}

static uint8_t UART_Read(uint8_t *b)
{
    uint32_t timeout = 2000000UL;
    while ((USART1->SR & USART_FLAG_RXNE) == 0) {
        if (--timeout == 0) return 0;
    }
    *b = (uint8_t)USART1->DR;
    return 1;
}

static void UART_WriteBytes(const uint8_t *data, uint16_t length)
{
    uint16_t i;
    for (i = 0; i < length; i++) UART_Write(data[i]);
}

static uint8_t ReadHeader(void)
{
    const uint8_t *h = InternalFlash_Pointer(IF_HEADER_OFFSET);
    uint32_t samples;
    uint32_t offset;
    if (h == 0) return 0;
    if (h[0] != 'D' || h[1] != 'S' || h[2] != 'E' || h[3] != 'T') return 0;
    if (Rd16LE(h + 4) != 1 || Rd16LE(h + 6) != 1) return 0;
    if (Rd32LE(h + 8) != 25600UL) return 0;

    samples = Rd32LE(h + 12);
    offset = Rd32LE(h + 16);
    if (samples == 0 || offset < IF_DATA_OFFSET) return 0;
    if (samples > (IF_MAX_DATA_BYTES / 2U)) return 0;
    if (offset + samples * 2U > IF_IMAGE_SIZE) return 0;

    PlaybackSamples = samples;
    PlaybackDataOffset = offset;
    PlaybackData = (const uint16_t *)(IF_IMAGE_BASE + offset);
    return 1;
}

static void StopPlayback(void)
{
    Playing = 0;
    GeneratorMode = 0;
    SampleIndex = 0;
}

static uint8_t StartPlayback(void)
{
    if (!ReadHeader()) {
        Playing = 0;
        return 0;
    }
    GeneratorMode = 0;
    DacTestMode = 0;
    SampleIndex = 0;
    PlaybackStartCount = SyncPulseCount;
    Playing = 1;
    return 1;
}
static void WriteDefaultDataSet(void)
{
    uint8_t header[64];
    uint8_t data[DEFAULT_SAMPLE_CNT * 2U];
    uint16_t i;
    uint32_t crc;

    for (i = 0; i < 64U; i++) header[i] = 0;
    for (i = 0; i < DEFAULT_SAMPLE_CNT; i++) {
        uint16_t v = SineTable[i];
        data[i * 2U] = (uint8_t)v;
        data[i * 2U + 1U] = (uint8_t)(v >> 8);
    }
    crc = CRC32_Calc(data, sizeof(data));

    header[0] = 'D'; header[1] = 'S'; header[2] = 'E'; header[3] = 'T';
    Wr16LE(header + 4, 1);
    Wr16LE(header + 6, 1);
    Wr32LE(header + 8, 25600UL);
    Wr32LE(header + 12, DEFAULT_SAMPLE_CNT);
    Wr32LE(header + 16, IF_DATA_OFFSET);
    Wr32LE(header + 20, crc);
    header[24] = 1;

    (void)InternalFlash_WriteMapped(IF_HEADER_OFFSET, header, sizeof(header));
    (void)InternalFlash_WriteMapped(IF_DATA_OFFSET, data, sizeof(data));
}

static void SetGeneratorFrequency(uint32_t freq)
{
    StopPlayback();
    DacTestMode = 0;
    GenFreqHz = freq;
    GenPhase = 0;
    GenPhaseInc = (uint16_t)((freq * 65536UL) / 25600UL);
    GeneratorMode = 1;
}


static uint16_t PlaybackScale(uint16_t code, uint16_t percent)
{
    int32_t delta = (int32_t)code - 32768;
    int32_t scaled = (delta * (int32_t)percent) / 100;
    if (scaled > 32767) scaled = 32767;
    if (scaled < -32768) scaled = -32768;
    return (uint16_t)(32768 + scaled);
}

void EXTI0_IRQHandler(void)
{
    if (EXTI_GetITStatus(EXTI_Line0) != RESET) {
        EXTI_ClearITPendingBit(EXTI_Line0);
        SyncPulseCount++;

        if (GeneratorMode) {
            TPC116S4_WriteChannel(0, SineTable[GenPhase >> 8]);
            GenPhase += GenPhaseInc;
        } else if (Playing && PlaybackData != 0 && PlaybackSamples != 0) {
            uint16_t code = PlaybackData[SampleIndex];
            TPC116S4_WriteFrame(
                PlaybackScale(code, 100),
                PlaybackScale(code, 75),
                PlaybackScale(code, 50),
                PlaybackScale(code, 25));
            SampleIndex++;
            if (SampleIndex >= PlaybackSamples) SampleIndex = 0;
        }
    }
}

static void SyncInput_Init(void)
{
    GPIO_InitTypeDef gpio;
    EXTI_InitTypeDef exti;
    NVIC_InitTypeDef nvic;

    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOA, ENABLE);
    RCC_APB2PeriphClockCmd(RCC_APB2Periph_SYSCFG, ENABLE);

    gpio.GPIO_Pin = GPIO_Pin_0;
    gpio.GPIO_Mode = GPIO_Mode_IN;
    gpio.GPIO_PuPd = GPIO_PuPd_DOWN;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_Init(GPIOA, &gpio);

    SYSCFG_EXTILineConfig(EXTI_PortSourceGPIOA, EXTI_PinSource0);
    exti.EXTI_Line = EXTI_Line0;
    exti.EXTI_Mode = EXTI_Mode_Interrupt;
    exti.EXTI_Trigger = EXTI_Trigger_Rising;
    exti.EXTI_LineCmd = ENABLE;
    EXTI_Init(&exti);

    nvic.NVIC_IRQChannel = EXTI0_IRQn;
    nvic.NVIC_IRQChannelPreemptionPriority = 0;
    nvic.NVIC_IRQChannelSubPriority = 0;
    nvic.NVIC_IRQChannelCmd = ENABLE;
    NVIC_Init(&nvic);
}

static void HandleCommand(uint8_t cmd)
{
    uint32_t addr;
    uint16_t len;
    uint16_t i;
    uint8_t x;
    uint8_t ok;

    if (cmd == CMD_PING) { UART_Write(0xAA); return; }
    if (cmd == CMD_DAC_TEST) { StopPlayback(); DacTestMode = 1; TPC116S4_WriteFrame(0x2000, 0x6000, 0xA000, 0xE000); UART_Write(ACK); return; }
    if (cmd == CMD_STOP) { InternalFlash_ResetEraseSession(); StopPlayback(); UART_Write(ACK); return; }
    if (cmd == CMD_PLAY) { ok = StartPlayback() ? ACK : NACK; UART_Write(ok); return; }
    if (cmd == CMD_GET_SYNC) {
        uint32_t count = SyncPulseCount;
        UART_Write(ACK);
        UART_WriteBytes((const uint8_t *)&count, 4);
        return;
    }
    if (cmd == CMD_SET_FREQ) {
        uint8_t b0, b1;
        if (!UART_Read(&b0) || !UART_Read(&b1)) { UART_Write(NACK); return; }
        SetGeneratorFrequency((uint32_t)b0 | ((uint32_t)b1 << 8));
        UART_Write(ACK);
        return;
    }
    if (cmd == CMD_ERASE) {
        uint8_t b0, b1, b2, b3;
        if (!UART_Read(&b0) || !UART_Read(&b1) || !UART_Read(&b2) || !UART_Read(&b3)) { UART_Write(NACK); return; }
        addr = (uint32_t)b0 | ((uint32_t)b1 << 8) | ((uint32_t)b2 << 16) | ((uint32_t)b3 << 24);
        if (addr >= IF_IMAGE_SIZE) { UART_Write(NACK); return; }
        ok = InternalFlash_EraseImage();
        UART_Write(ok ? ACK : NACK);
        return;
    }
    if (cmd == CMD_WRITE || cmd == CMD_READ) {
        uint8_t b0, b1, b2, b3, l0, l1;
        if (!UART_Read(&b0) || !UART_Read(&b1) || !UART_Read(&b2) || !UART_Read(&b3) ||
            !UART_Read(&l0) || !UART_Read(&l1)) { UART_Write(NACK); return; }
        addr = (uint32_t)b0 | ((uint32_t)b1 << 8) | ((uint32_t)b2 << 16) | ((uint32_t)b3 << 24);
        len = (uint16_t)l0 | ((uint16_t)l1 << 8);
        if (len == 0 || len > 256) { UART_Write(NACK); return; }
        if (cmd == CMD_WRITE) {
            uint8_t load[256];
            for (i = 0; i < len; i++) if (!UART_Read(&x)) { UART_Write(NACK); return; } else load[i] = x;
            ok = InternalFlash_WriteMapped(addr, load, len);
            UART_Write(ok ? ACK : 0xE2);
        } else {
            uint8_t load[256];
            ok = InternalFlash_ReadMapped(addr, load, len);
            UART_Write(ok ? ACK : NACK);
            if (ok) UART_WriteBytes(load, len);
        }
        return;
    }
}
static void LCD_ShowStatus(void)
{
    char line[32];

    LCD_SetAsciiFont(&ASCII_Font16);
    LCD_SetColor(LCD_WHITE);
    LCD_SetBackColor(LCD_BLACK);
    LCD_ClearRect(0, 0, 240, 160);

    LCD_DisplayString(0, 0,  "STM32F407 DATASET");
    LCD_DisplayString(0, 24, "STORAGE: INT FLASH");

    if (DacTestMode) {
        LCD_DisplayString(0, 48, "MODE: DAC 4CH");
        LCD_DisplayString(0, 72, "A/B/C/D DC TEST");
    } else if (GeneratorMode) {
        LCD_DisplayString(0, 48, "MODE: SINE GEN");
        sprintf(line, "FREQ: %lu Hz", (unsigned long)GenFreqHz);
        LCD_DisplayString(0, 72, line);
    } else if (Playing) {
        LCD_DisplayString(0, 48, "MODE: PLAY");
        sprintf(line, "SAMPLES: %lu", (unsigned long)PlaybackSamples);
        LCD_DisplayString(0, 72, line);
    } else {
        LCD_DisplayString(0, 48, "MODE: STOP");
        LCD_DisplayString(0, 72, "WAIT COMMAND");
    }

    sprintf(line, "SYNC: %lu", (unsigned long)SyncPulseCount);
    LCD_DisplayString(0, 96, line);
    sprintf(line, "DATA: 0x%08lX", (unsigned long)(IF_IMAGE_BASE + PlaybackDataOffset));
    LCD_DisplayString(0, 120, line);
}

int main(void)
{
    uint8_t cmd;
    uint32_t lcd_count = 0;

    Delay_Init();
    LED_Init();
    KEY_Init();
    Usart_Config();
    TPC116S4_Init();

    RCC_APB2PeriphClockCmd(RCC_APB2Periph_SYSCFG, ENABLE);

    SPI_LCD_Init();
    LCD_SetAsciiFont(&ASCII_Font16);
    LCD_SetColor(LCD_WHITE);
    LCD_SetBackColor(LCD_BLACK);
    LCD_Clear();

    InternalFlash_Init();
    if (!ReadHeader()) {
        WriteDefaultDataSet();
        (void)ReadHeader();
    }

    SyncInput_Init();
    (void)StartPlayback();
    LCD_ShowStatus();

    while (1) {
        if (USART1->SR & USART_FLAG_RXNE) {
            cmd = (uint8_t)USART1->DR;
            HandleCommand(cmd);
            lcd_count = 0;
            LCD_ShowStatus();
        }

        if (KEY_Scan() == KEY_ON) {
            if (Playing || GeneratorMode) StopPlayback();
            else (void)StartPlayback();
            LCD_ShowStatus();
        }

        Delay_ms(10);
        lcd_count++;
        if (lcd_count >= 50U) {
            lcd_count = 0;
            LED1_Toggle;
            LCD_ShowStatus();
        }
    }
}
