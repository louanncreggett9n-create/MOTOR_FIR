##############################################################################
# P3 UI - ACX720-V3 on-board J1 40P FPC (TFT pins only; clk/reset/LED stay in Top.xdc)
##############################################################################
set_property PACKAGE_PIN AB20 [get_ports TFT_clk]
set_property PACKAGE_PIN AB22 [get_ports TFT_de]
set_property PACKAGE_PIN AB21 [get_ports TFT_pwm]
set_property PACKAGE_PIN V19  [get_ports TFT_hs]
set_property PACKAGE_PIN Y19  [get_ports TFT_vs]
set_property PACKAGE_PIN N14  [get_ports {TFT_rgb[15]}]
set_property PACKAGE_PIN P16  [get_ports {TFT_rgb[14]}]
set_property PACKAGE_PIN R17  [get_ports {TFT_rgb[13]}]
set_property PACKAGE_PIN N15  [get_ports {TFT_rgb[12]}]
set_property PACKAGE_PIN L6   [get_ports {TFT_rgb[11]}]
set_property PACKAGE_PIN T18  [get_ports {TFT_rgb[10]}]
set_property PACKAGE_PIN N17  [get_ports {TFT_rgb[9]}]
set_property PACKAGE_PIN P17  [get_ports {TFT_rgb[8]}]
set_property PACKAGE_PIN P15  [get_ports {TFT_rgb[7]}]
set_property PACKAGE_PIN R16  [get_ports {TFT_rgb[6]}]
set_property PACKAGE_PIN N13  [get_ports {TFT_rgb[5]}]
set_property PACKAGE_PIN U17  [get_ports {TFT_rgb[4]}]
set_property PACKAGE_PIN U18  [get_ports {TFT_rgb[3]}]
set_property PACKAGE_PIN P14  [get_ports {TFT_rgb[2]}]
set_property PACKAGE_PIN R14  [get_ports {TFT_rgb[1]}]
set_property PACKAGE_PIN R18  [get_ports {TFT_rgb[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports TFT_clk]
set_property IOSTANDARD LVCMOS33 [get_ports TFT_de]
set_property IOSTANDARD LVCMOS33 [get_ports TFT_pwm]
set_property IOSTANDARD LVCMOS33 [get_ports TFT_hs]
set_property IOSTANDARD LVCMOS33 [get_ports TFT_vs]
set_property IOSTANDARD LVCMOS33 [get_ports {TFT_rgb[*]}]
# GT911 is mapped through the TFT backplane RN9 option to the 40P J1 FPC:
# Factory-verified P7 mapping: TP_SCL=T21, TP_SDA=T20, TP_INT=P20, TP_RST=Y21.
set_property PACKAGE_PIN T21 [get_ports tp_scl]
set_property PACKAGE_PIN T20 [get_ports tp_sda]
set_property PACKAGE_PIN P20 [get_ports tp_int]
set_property PACKAGE_PIN Y21 [get_ports tp_rst]
set_property IOSTANDARD LVCMOS33 [get_ports tp_scl]
set_property IOSTANDARD LVCMOS33 [get_ports tp_sda]
set_property IOSTANDARD LVCMOS33 [get_ports tp_int]
set_property PULLUP true [get_ports tp_scl]
set_property PULLUP true [get_ports tp_sda]
set_property PULLUP true [get_ports tp_int]
set_property IOSTANDARD LVCMOS33 [get_ports tp_rst]
# Internal weak pull-ups are a diagnostic/backup for the backplane 4.7k resistors.
